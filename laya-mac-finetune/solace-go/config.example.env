# Transport: mqtt (default pure-Go build) or smf (make build-smf).
SOLACE_TRANSPORT=mqtt

# Copy exact values from the Solace service's Connect tab.
# MQTT: tcp://host:1883 or ssl://host:8883
# SMF:  tcp://host:55555 or tcps://host:55443
SOLACE_BROKER_URL=ssl://your-service.messaging.solace.cloud:8883
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_CLIENT_ID=laya-event-router-01

# Topic syntax is transport-specific:
# MQTT uses + and #. Native SMF uses *, prefix*, and terminal >.
SOLACE_INPUT_FILTER=edm0/pilot/events/#
SOLACE_OUTPUT_TOPIC=edm0/pilot/results/{route}

# MQTT-only settings.
SOLACE_QOS=1
SOLACE_CLEAN_SESSION=false

# SMF-only settings. Also use tcps://...:55443 and edm0/pilot/events/>.
# Use a preprovisioned durable queue by default.
SOLACE_SMF_VPN=
SOLACE_SMF_QUEUE=edm0-routing-pilot
SOLACE_SMF_QUEUE_EXCLUSIVE=true
SOLACE_SMF_ADD_SUBSCRIPTION=false
SOLACE_SMF_PROVISION=false
# Optional CA directory for tcps://; certificate and hostname validation remain enabled.
SOLACE_SMF_TRUST_STORE=

# Paths are resolved from solace-go/ by the documented commands.
LAYA_MODEL=../outputs/best-model
LAYA_DEVICE=mps
LAYA_PYTHON=../.venv/bin/python
LAYA_WORKER_SCRIPT=python_worker.py

BRIDGE_QUEUE_CAPACITY=32
BRIDGE_MAX_EVENT_BYTES=262144
BRIDGE_MAX_MESSAGES=0
BRIDGE_STORE_DIR=.state/mqtt
BRIDGE_AUDIT_FILE=
BRIDGE_OFFLINE_INPUT_TOPIC=offline/events
BRIDGE_ENQUEUE_TIMEOUT=250ms
BRIDGE_INFERENCE_TIMEOUT=5s
BRIDGE_PUBLISH_TIMEOUT=5s
BRIDGE_STARTUP_TIMEOUT=90s
BRIDGE_SHUTDOWN_TIMEOUT=15s
BRIDGE_IDLE_TIMEOUT=0s
